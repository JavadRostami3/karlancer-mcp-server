# Public HTTPS origin (no trailing slash)
BASE_URL=https://mcp.example.com
# openssl rand -hex 32 (keep this unchanged after first deployment)
MASTER_KEY=REPLACE_WITH_64_HEX_CHARACTERS
# SHA-256 of the initial owner phone normalized to 10 digits: 9xxxxxxxxx
OWNER_PHONE_HASH=REPLACE_WITH_64_HEX_CHARACTERS
PORT=8940
DB_PATH=/app/data/state.sqlite
